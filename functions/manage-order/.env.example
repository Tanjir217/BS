# Appwrite database configuration required by the manage-order Function.
# Set these in Appwrite Console > Functions > manage-order > Settings > Environment variables.
# Do NOT commit real values here.
APPWRITE_DATABASE_ID=
APPWRITE_PRODUCTS_TABLE_ID=
APPWRITE_ORDERS_TABLE_ID=
APPWRITE_ORDER_ITEMS_TABLE_ID=
APPWRITE_RETURN_REQUESTS_TABLE_ID=
APPWRITE_DELIVERY_SHIPMENTS_TABLE_ID=
APPWRITE_MANAGEMENT_TEAM_ID=

# Optional Pathao Courier integration.
# Keep all Pathao credentials server-side; never put them in the Vite client .env.
# Production base URL from Pathao's current Merchant API ecosystem.
PATHAO_API_BASE_URL=https://api-hermes.pathao.com
PATHAO_ACCESS_TOKEN=
PATHAO_STORE_ID=
PATHAO_DELIVERY_TYPE=48
PATHAO_ITEM_TYPE=2
PATHAO_DEFAULT_ITEM_WEIGHT=0.5
